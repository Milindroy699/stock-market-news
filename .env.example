ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The Ken premium — full raw cookie string
# How to get it:
#   1. Log into https://the-ken.com in Chrome/Firefox
#   2. Open DevTools (Cmd+Option+I) → Network tab → reload the page
#   3. Click any request to the-ken.com → Request Headers → find "Cookie:"
#   4. Copy the ENTIRE value of the Cookie header (e.g. "name1=val1; name2=val2; ...")
#   5. Paste the whole string below (keep it on one line)
THE_KEN_COOKIE_STRING=

# Reddit API (optional — for r/IndiaInvestments)
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockMarketNewsBot/1.0

# Schedule time in 24h IST (default 7 AM)
SCHEDULE_TIME=07:00

# Web server port
WEB_PORT=8000
